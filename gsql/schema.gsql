USE GRAPH FraudGraph

DROP ALL

CREATE VERTEX Customer (PRIMARY_ID id STRING, risk_score FLOAT)
CREATE VERTEX Card (PRIMARY_ID id STRING, card_type STRING, issuer STRING)
CREATE VERTEX Transaction (PRIMARY_ID id STRING, amount FLOAT, amt_usd FLOAT, timestamp INT, risk_score FLOAT, status STRING)
CREATE VERTEX Device (PRIMARY_ID id STRING, device_info STRING, os STRING)
CREATE VERTEX IPAddress (PRIMARY_ID id STRING, ip STRING)
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING, domain STRING)
CREATE VERTEX FraudCase (PRIMARY_ID id STRING, status STRING, initial_score FLOAT, final_risk STRING, creation_time INT)
CREATE VERTEX CaseEvidence (PRIMARY_ID id STRING, evidence_type STRING, details STRING, timestamp INT)

CREATE DIRECTED EDGE OWNS_CARD (FROM Customer, TO Card)
CREATE DIRECTED EDGE PERFORMED_TX (FROM Customer, TO Transaction)
CREATE DIRECTED EDGE USED_DEVICE (FROM Transaction, TO Device)
CREATE DIRECTED EDGE FROM_IP (FROM Transaction, TO IPAddress)
CREATE DIRECTED EDGE HAS_EMAIL (FROM Customer, TO EmailDomain)
CREATE DIRECTED EDGE LINKED_TO_CASE (FROM Transaction, TO FraudCase)
CREATE DIRECTED EDGE CASE_HAS_EVIDENCE (FROM FraudCase, TO CaseEvidence)
CREATE DIRECTED EDGE SIMILAR_TO_PAST_CASE (FROM FraudCase, TO FraudCase, score FLOAT)

INSTALL QUERY ALL